# Copy to mini_agent/.env (gitignored). NON-SECRET tuning only — connection values (LLM_BASE_URL,
# LLM_API_KEY, LLM_MODEL) belong in .env.op. This file is loaded with override=False, so anything
# `op run` injects wins over it.

# Reasoning model: thinking tokens count against this. Too low → every reply is an overrun.
LLM_MAX_TOKENS=16384
# Thinking cap: max_tokens for a normal reply; a reply right after an overrun gets the full LLM_MAX_TOKENS.
# Unset or 0 = off (every reply gets LLM_MAX_TOKENS).
#AGENT_THINKING_CAP=8192
# Time awareness: each command result shows the time used; one nudge at 10 min to write a working answer.
#AGENT_TIME_AWARENESS=on
# Qwen3 thinking-mode sampling from the model card (near-greedy decoding makes thinking models loop).
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95

AGENT_MAX_TURNS=100
AGENT_COMMAND_TIMEOUT_SEC=180

# Context saving, both off by default (experiment: docs/plans/self-compaction-mvp.md).
#AGENT_STRIP_REASONING=on             # don't re-send the model's earlier thinking
#AGENT_COMPACTION=on                  # self_compact tool + notice / warning / hard stages
#LLM_CONTEXT_WINDOW=250000            # the stages sit at 10% / 20% / 30% of this ...
#COMPACT_NOTICE_AT=25000              # ... unless set directly, in tokens
#COMPACT_WARNING_AT=50000
#COMPACT_HARD_AT=75000
#COMPACT_FORCED_THINKING=on          # let the model think on forced self_compact turns (default off)

#LLM_LITELLM_PROVIDER=openai          # litellm prefix used as <provider>/<LLM_MODEL>
#BADGER_CONFIG=terminal_bench.yaml    # agent prompt/config file in badger_mini/config/

# Langfuse job summaries (badger_mini/langfuse_export.py): after each run_*.sh run, upload the job's summary.
# Off by default; keys go in .env.op. Needs: uv pip install -e "mini_agent/[tracing]"
#LANGFUSE_ENABLED=1
