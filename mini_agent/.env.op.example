# Copy to mini_agent/.env.op (gitignored) and replace <your-item>.
#
# These are 1Password secret REFERENCES, not secrets. `op run` resolves them at launch and injects the
# real values into the launched process only — they never touch disk and never enter the task container.
#
#   op run --env-file=mini_agent/.env.op -- ./mini_agent/scripts/run_sample.sh fix-git
#
# In 1Password: open the item → field menu → "Copy Secret Reference". Quote refs containing spaces.
LLM_BASE_URL="op://Employee/<your-item>/base url"
LLM_API_KEY="op://Employee/<your-item>/credential"

# Model id exactly as GET $LLM_BASE_URL/models reports it (check with ./mini_agent/scripts/check_endpoint.sh).
# The llm-gw01 gateway serves only qwen3.8-27b (+ qwen3-vl-embedding-8b, churro-3b); asking it for
# Qwen3.6-27B-FP8 gives 400 "Invalid model name". qwen3.8-27b is fine for development but is NOT on
# the approved list, so a submitted run needs an endpoint that serves Qwen/Qwen3.6-27B-FP8 (or another
# approved checkpoint) — swap LLM_BASE_URL/LLM_API_KEY/LLM_MODEL here when you have one.
LLM_MODEL=qwen3.8-27b
